# ============================================================
# Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit the .env file to Git.
# ============================================================

# --- PostgreSQL Database ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=disaster_db
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password_here
DB_URL=jdbc:postgresql://localhost:5432/disaster_db

# --- Spring Boot Backend ---
BACKEND_PORT=8081
AI_SERVICE_URL=http://localhost:8000

# --- FastAPI AI Service ---
AI_SERVICE_PORT=8000
MODEL_PATH=data/models/

# --- React Frontend ---
VITE_API_BASE_URL=http://localhost:8081/api
# Optional: Cesium Ion Token for Cesium World Terrain (free at https://cesium.com/ion/)
# If left blank, DRAS seamlessly falls back to free high-res satellite and WGS84 Ellipsoid terrain.
VITE_CESIUM_ION_TOKEN=
